# Copiá este archivo como ".env" y completá los valores.
# El archivo .env NO se sube a Git (está en .gitignore).

# Nombre de la aplicación (se muestra en la cabecera y en el <title>)
APP_NAME="Mi Sitio Web"

# Titular del sitio (se muestra en el pie de página)
APP_OWNER="WayerFC"

# Email de soporte / contacto
SUPPORT_EMAIL="soporte@example.com"

# Entorno de ejecución: local | production
APP_ENV=local
